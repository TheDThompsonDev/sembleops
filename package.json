{
  "name": "sembleops",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted operations ensemble for commitments and reviewable agent work.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:ui": "vite",
    "worker": "tsx src/worker/main.ts",
    "build": "tsc && node scripts/copy-assets.mjs && vite build",
    "build:ui": "vite build",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "chrono-node": "^2.10.1",
    "discord.js": "^14.27.0",
    "fastify": "^5.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.3",
    "sharp": "^0.35.3",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  }
}
